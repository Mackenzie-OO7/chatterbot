# Database
# Development (SQLite): Use file-based database
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL): Uncomment and use when deploying
# DATABASE_URL="postgresql://user:password@localhost:5432/gitgreen?schema=public"
#
# 🔄 IMPORTANT: When switching to PostgreSQL in production:
# 1. Update prisma/schema.prisma: change provider to "postgresql"
# 2. Update DATABASE_URL above to your PostgreSQL connection string
# 3. Run: npx prisma generate && npx prisma db push

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# Hedera Testnet
HEDERA_NETWORK="testnet"
HEDERA_ACCOUNT_ID="0.0.xxxxx"
HEDERA_PRIVATE_KEY="your-hedera-private-key"
HEDERA_PUBLIC_KEY="your-hedera-public-key"

# Guardian API (local instance via Docker)
GUARDIAN_API_URL="http://localhost:3000/api/v1"
GUARDIAN_USERNAME="gitgreen_registry"
GUARDIAN_PASSWORD="your-guardian-password-here"
GUARDIAN_POLICY_ID="your-policy-id-here"

# Guardian Mode (set to "true" to use mock, "false" to use real Guardian)
USE_MOCK_GUARDIAN="true"

# IPFS (optional - for metadata storage)
PINATA_API_KEY="your-pinata-api-key"
PINATA_SECRET_KEY="your-pinata-secret-key"

# Application
NODE_ENV="development"
